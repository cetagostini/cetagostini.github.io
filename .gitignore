# Quarto website output
/.quarto/
/_site/

# Keep _freeze directory for frozen computations
# !/_freeze/

# R
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Environment
.env
.venv
env/
venv/
ENV/

# Generated audio (per-article) — keep .txt source files
articles/*/audio/*.wav

# OS specific
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Cursor
.cursor/

# Claude
.claude/

# Central skills repository
.repository/

# Dev-only scripts and scratch work
.dev/
**/*.quarto_ipynb

# Local environment overrides (may hold credentials)
_environment.local
/_*.local

# Local agent handoff docs (unpublished scratch)
/local:/

# Local research data & prototypes — never publish
/research/

# Stale article notebook exports — the .qmd is the source of truth
articles/*/*.ipynb

# Scratch pages kept off the site
_hidden.qmd

# i18n build artifacts (extracted records — dumps and their .stats.json — are
# committed: they are the source of truth for what still needs translating)
_i18n_dump/
_i18n_*
.i18n-*-built
i18n/*/compiled/
